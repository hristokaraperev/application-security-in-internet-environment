# Copy this file to `.env` before running `docker-compose up`.
# In a real deployment these would be injected from a secret manager, never committed.

# Shared secret for the gateway -> service token (HMAC). Must match across
# gateway-service and wallet-service.
GATEWAY_SHARED_SECRET=please-change-this-to-a-long-random-value

# Database credentials
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=authpass
WALLET_DB_USER=wallet
WALLET_DB_PASSWORD=walletpass
